#!/bin/sh
# Meridian Kernel — refuse to push a kernel that does not pass its own validator.
#
# Runs against the synthetic instance fixture, so it works offline and without
# access to any private Instance. This is the same check CI runs, moved earlier:
# a red kernel should not reach the remote in the first place.
#
# Enable in a fresh clone:  git config core.hooksPath hooks
# Bypass (deliberately):    git push --no-verify

set -e
ROOT=$(git rev-parse --show-toplevel)

echo "pre-push: running the validator's own regression suite"
if ! node "$ROOT/test/kernel-validate.test.mjs"; then
  echo ""
  echo "pre-push: BLOCKED — the validator regression suite failed."
  echo "pre-push: a rule of kernel-validate.mjs no longer fires as claimed."
  exit 1
fi

echo "pre-push: running kernel-validate against test/instance-fixture"
if ! MERIDIAN_INSTANCE="$ROOT/test/instance-fixture" node "$ROOT/scripts/kernel-validate.mjs"; then
  echo ""
  echo "pre-push: BLOCKED — the kernel validator failed."
  echo "pre-push: this run used the synthetic fixture; it does NOT check the real"
  echo "pre-push: product's literals. Run with MERIDIAN_INSTANCE pointed at the"
  echo "pre-push: private Instance for that."
  exit 1
fi

# When MERIDIAN_INSTANCE points at a real Instance (not this fixture), run
# the same validator through the logging wrapper: it records one metrics
# entry per push into that Instance's own gate-run log
# (standards/workspace/feedback-and-metrics.md), with zero extra operator
# action. This does not block push on its own: a red result here has always
# been informational at this hook, and this change only adds a data point,
# not a new block.
if [ -n "$MERIDIAN_INSTANCE" ] && [ "$MERIDIAN_INSTANCE" != "$ROOT/test/instance-fixture" ]; then
  echo ""
  echo "pre-push: running kernel-validate against the configured Instance (logged, non-blocking)"
  node "$ROOT/scripts/validate-and-log.mjs" || echo "pre-push: the real-Instance run reported problems above — push proceeds, but review them"
fi
