{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://meridian.invalid/registries/operating-model/foundation.schema.json",
  "title": "Meridian operating foundation registry",
  "description": "Machine-readable identities of the universal Meridian terms and principles whose definitions and normative signatures live in the paired operating-glossary.md and operating-principles.md documents.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "terms", "principles"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/term" }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/principle" }
    }
  },
  "definitions": {
    "semantic_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "machine_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:-[A-Za-z0-9]+)*$"
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonical_ru", "canonical_en"],
      "properties": {
        "id": { "$ref": "#/definitions/semantic_id" },
        "canonical_ru": { "type": "string", "minLength": 1 },
        "canonical_en": { "type": "string", "minLength": 1 },
        "machine_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/machine_name" }
        }
      }
    },
    "principle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title_ru", "title_en"],
      "properties": {
        "id": { "$ref": "#/definitions/semantic_id" },
        "title_ru": { "type": "string", "minLength": 1 },
        "title_en": { "type": "string", "minLength": 1 }
      }
    }
  }
}
