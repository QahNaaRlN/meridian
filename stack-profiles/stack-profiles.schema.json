{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stack-profiles.schema.json",
  "title": "Meridian Stack Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "manifest", "requires"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "manifest": { "type": "string", "minLength": 1 },
          "requires": { "$ref": "#/definitions/sections" },
          "forbids": { "$ref": "#/definitions/sections" },
          "forbids_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "definitions": {
    "sections": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 1 }
      }
    }
  }
}
